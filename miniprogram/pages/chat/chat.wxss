.page{height:100vh;display:flex;flex-direction:column}.hero{padding:32rpx;background:#173f5f;color:white}.title{font-size:40rpx;font-weight:700}.sub{font-size:24rpx;opacity:.75;margin-top:8rpx}.messages{flex:1;height:0;padding:24rpx;box-sizing:border-box}.welcome{background:white;border-radius:20rpx;padding:30rpx;color:#597083}.row{display:flex;margin:18rpx 0}.row.user{justify-content:flex-end}.bubble{max-width:78%;padding:22rpx 26rpx;border-radius:22rpx;background:white;line-height:1.55}.user .bubble{background:#276fbf;color:white}.sources{font-size:21rpx;color:#789;margin-top:14rpx;border-top:1px solid #e8edf2;padding-top:10rpx}.composer{display:flex;background:white;padding:18rpx 22rpx;gap:14rpx}.composer input{flex:1;background:#f0f3f7;border-radius:32rpx;padding:0 24rpx}.composer button{font-size:28rpx;background:#276fbf;color:white;border-radius:30rpx}

