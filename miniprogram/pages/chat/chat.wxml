<view class="page">
  <view class="hero"><view class="title">Admissions Assistant</view><view class="sub">招生政策、专业与申请流程智能问答</view></view>
  <scroll-view class="messages" scroll-y scroll-into-view="bottom">
    <view wx:if="{{messages.length === 0}}" class="welcome">你好！可以问我“申请需要哪些材料？”或“有哪些新生奖学金？”</view>
    <view wx:for="{{messages}}" wx:key="index" class="row {{item.role}}"><view class="bubble"><text user-select>{{item.content}}</text><view wx:if="{{item.sources.length}}" class="sources">参考：<text wx:for="{{item.sources}}" wx:key="source">{{item.title}} </text></view></view></view>
    <view id="bottom"></view>
  </scroll-view>
  <view class="composer"><input value="{{input}}" bindinput="onInput" confirm-type="send" bindconfirm="send" placeholder="输入招生问题…"/><button bindtap="send" loading="{{loading}}" disabled="{{loading}}">发送</button></view>
</view>

